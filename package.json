{
  "name": "jiuli",
  "version": "3.1.3",
  "description": "JiuLi - 兼容 TRSS-Yunzai 生态的机器人框架",
  "type": "module",
  "main": "app.js",
  "bin": {
    "jiuli": "./jiuli.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/index.d.ts",
      "default": "./lib/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "node jiuli.mjs init",
    "app": "node .",
    "dev": "node . dev",
    "start": "node jiuli.mjs start",
    "stop": "node jiuli.mjs stop",
    "restart": "node jiuli.mjs rs",
    "rs": "node jiuli.mjs rs",
    "log": "node jiuli.mjs log",
    "jiuli": "node jiuli.mjs",
    "build": "tsc",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs",
    "test:hot": "node test/hotreload.mjs",
    "test:restart": "node test/supervisor-check.mjs",
    "test:all": "node test/smoke.mjs && node test/daemon-stop.mjs && node test/broken-plugin.mjs && node test/ecosystem-gate.mjs && node test/redis-fallback.mjs && node test/hotreload.mjs && node test/supervisor-check.mjs && node test/update-check.mjs && node test/cli-session.mjs && node test/cli-args.mjs && node test/cli-deps.mjs && node test/plugin-dedup.mjs && node test/install-plugin.mjs && node test/rule-args.mjs && node test/deps-check.mjs && node test/log-dedupe.mjs && node test/ported-plugins.mjs",
    "test:ported": "node test/ported-plugins.mjs",
    "test:update": "node test/update-check.mjs",
    "test:load": "node test/load-check.mjs",
    "test:daemon": "node test/daemon-stop.mjs",
    "test:cli": "node test/cli-session.mjs && node test/cli-args.mjs && node test/cli-deps.mjs",
    "test:broken": "node test/broken-plugin.mjs",
    "test:redis": "node test/redis-fallback.mjs",
    "test:render": "node test/render-check.mjs",
    "test:dedup": "node test/plugin-dedup.mjs",
    "test:install": "node test/install-plugin.mjs",
    "test:args": "node test/rule-args.mjs",
    "test:deps": "node test/deps-check.mjs",
    "test:logdedupe": "node test/log-dedupe.mjs",
    "test:trss": "node test/trss-archive.mjs",
    "test:trsstpl": "node test/trss-template.mjs"
  },
  "imports": {
    "#miao": "./plugins/miao-plugin/components/index.js",
    "#miao.models": "./plugins/miao-plugin/models/index.js"
  },
  "dependencies": {
    "@zxing/library": "^0.23.0",
    "art-template": "4.13.2",
    "chalk": "^5.3.0",
    "chokidar": "^4.0.3",
    "compression": "^1.8.1",
    "es-toolkit": "^1.52.0",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "fluent-ffmpeg": "^2.1.3",
    "https-proxy-agent": "^7.0.6",
    "image-size": "^2.0.2",
    "jsqr": "^1.4.0",
    "level": "^10.0.0",
    "lodash": "^4.17.21",
    "log4js": "^6.9.1",
    "md5": "link:lib/modules/md5",
    "moment": "^2.30.1",
    "node-fetch": "link:lib/modules/node-fetch",
    "node-schedule": "^2.1.1",
    "oicq": "link:lib/modules/oicq",
    "pm2": "^7.0.4",
    "puppeteer": "*",
    "redis": "^4.7.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.33.2",
    "sqlite3": "npm:@karinjs/sqlite3@^0.4.3",
    "strip-ansi": "^7.2.0",
    "ulid": "^3.0.2",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.13",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
