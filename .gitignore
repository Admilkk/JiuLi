node_modules/
pnpm-lock.yaml.bak

# 构建产物（lib/core 与 lib/index.* 由 tsc 生成）
lib/core/
lib/index.js
lib/index.d.ts
lib/**/*.d.ts
lib/**/*.js.map

# 运行时数据
logs/
data/
temp/
.redis-data/

# ---- 插件与配置策略（与 TRSS-Yunzai 一致）----
# 仅跟踪内置插件；第三方插件及其 node_modules 不入库
/plugins/*
!/plugins/adapter
!/plugins/system
!/plugins/other
!/plugins/jiuli-adapter-mock
!/plugins/jiuli-example-class
!/plugins/jiuli-example-dsl

# 插件在 config/ 根目录写配置（可能含账号凭据），不入库
/config/*
!/config/default_config/
renderers/*/config.yaml

# 冒烟测试夹具（从 TRSS-Yunzai 复制的旧插件样本）
plugins/_legacy/

# 编辑器
.idea/
.vscode/
*.log
