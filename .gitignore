node_modules/
pnpm-lock.yaml.bak

# 构建产物（lib/core 与 lib/index.* 由 tsc 生成）
lib/core/
lib/index.js
lib/index.d.ts
lib/**/*.d.ts
lib/**/*.js.map

# 运行时数据
logs/
data/
temp/
.redis-data/

# ---- 插件与配置策略（与 TRSS-Yunzai 一致）----
# 仅跟踪内置插件与示例；第三方插件及其 node_modules 不入库
/plugins/*
!/plugins/README.md
!/plugins/adapter
!/plugins/system
!/plugins/other
!/plugins/dev-adapter-mock
!/plugins/example-class
!/plugins/example-dsl
!/plugins/example-render

# 插件在 config/ 根目录写配置（可能含账号凭据），不入库
/config/*
!/config/default_config/
renderers/*/config.yaml

# 冒烟测试夹具（test/fixtures 在运行时复制到此目录）
plugins/_test-fixtures/

# 编辑器
.idea/
.vscode/
*.log
